<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textSize="24sp"
            android:textColor="@color/jf_text"
            android:layout_marginBottom="40dp"
            android:gravity="center" />

        <EditText
            android:id="@+id/serverUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/server_url"
            android:text="https://8096-ec40bc675bd1084a.monkeycode-ai.online"
            android:textSize="14sp"
            android:textColor="@color/jf_text"
            android:textColorHint="@color/jf_text_secondary"
            android:background="@drawable/edit_bg"
            android:padding="12dp"
            android:inputType="textUri"
            android:nextFocusDown="@+id/usernameEdit" />

        <EditText
            android:id="@+id/usernameEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:hint="@string/username"
            android:text="root"
            android:textSize="16sp"
            android:textColor="@color/jf_text"
            android:textColorHint="@color/jf_text_secondary"
            android:background="@drawable/edit_bg"
            android:padding="12dp"
            android:inputType="text"
            android:nextFocusDown="@+id/passwordEdit" />

        <EditText
            android:id="@+id/passwordEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:hint="@string/password"
            android:text="000000"
            android:textSize="16sp"
            android:textColor="@color/jf_text"
            android:textColorHint="@color/jf_text_secondary"
            android:background="@drawable/edit_bg"
            android:padding="12dp"
            android:inputType="textPassword"
            android:nextFocusDown="@+id/loginButton" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_login"
            android:textSize="18sp"
            android:textColor="@color/jf_text"
            android:background="@drawable/btn_primary"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="@color/jf_text_secondary"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>