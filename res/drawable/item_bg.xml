<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#00A4DC" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="#00A4DC" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2A3340" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/jf_card" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>